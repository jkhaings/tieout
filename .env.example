# Anthropic — narration + judge
ANTHROPIC_API_KEY=

# SEC requires a descriptive User-Agent with contact info (their fair-use policy)
SEC_USER_AGENT=tieout/0.1 (contact: you@example.com)

# Langfuse tracing — optional; leave empty and tracing becomes a no-op
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# App
APP_ENV=dev
RATE_LIMIT_RUNS_PER_HOUR=6
DAILY_RUN_CAP=50
# Comma-separated list of origins allowed to call the API cross-origin.
CORS_ORIGINS=http://localhost:8000
# Where generated workbooks and the run log live. Relative paths are
# resolved from the repo root and created automatically if missing.
RUNS_DIR=data/runs
RUN_LOG_PATH=data/runs.db
# Off by default: SentenceTransformerEmbedder/CrossEncoderReranker download
# model weights from Hugging Face Hub on first use with no timeout of their
# own. Only set to true if those weights are already cached locally (e.g.
# baked into the container image at build time) -- see app/settings.py.
ENABLE_LOCAL_EMBEDDINGS=false
